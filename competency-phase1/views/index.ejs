                            </div>
                            <div class="carousel-inner"> 
                                <% 
                                const slidesAzure = [
                                { file: '1-azure', alt: 'Azure API Deployment - The NestJS backend API successfully deployed on Azure App Service, showing a green tick.' },
                                { file: '2-azure-sql-1', alt: 'Azure SQL Database - Database dashboard showing storage usage and basic database metrics for the competency data.' },
                                { file: '3-azure-dashboard-1', alt: 'Azure Resource Overview - High-level Azure dashboard displaying all resources deployed for Phase 1 of the Competency App' },
                                { file: '4-github-1', alt: 'CI/CD Workflow - GitHub Actions workflow automatically building and deploying the backend API to Azure on each push.' },
                                { file: '5-azure-subscription-1', alt: 'Azure Costs - Subscription dashboard showing current and forecasted costs, explaining the motivation to migrate.' }
                                ]; 
                                slidesAzure.forEach((slide, index) => { 
                                %>
                                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>" data-bs-interval="4000">
                                        <div class="position-relative">
                                            <picture>
                                            <source 
                                                srcset="
                                                /images/responsive/<%= slide.file %>-400.webp 400w,
                                                /images/responsive/<%= slide.file %>-800.webp 800w,
                                                /images/responsive/<%= slide.file %>-1200.webp 1200w,
                                                /images/responsive/<%= slide.file %>-1600.webp 1600w,
                                                /images/responsive/<%= slide.file %>-2400.webp 2400w
                                                "
                                                sizes="(max-width: 576px) 100vw, 
                                                        (max-width: 768px) 80vw,
                                                        (max-width: 1200px) 45vw, 
                                                        30vw"
                                                type="image/webp"
                                            >
                                            <source 
                                                srcset="
                                                /images/responsive/<%= slide.file %>-400.jpg 400w,
                                                /images/responsive/<%= slide.file %>-800.jpg 800w,
                                                /images/responsive/<%= slide.file %>-1200.jpg 1200w,
                                                /images/responsive/<%= slide.file %>-1600.jpg 1600w,
                                                /images/responsive/<%= slide.file %>-2400.jpg 2400w
                                                "
                                                sizes="(max-width: 576px) 100vw, 
                                                        (max-width: 768px) 80vw,
                                                        (max-width: 1200px) 45vw, 
                                                        30vw"
                                                type="image/jpeg"
                                            >
                                            <img 
                                                src="/images/responsive/<%= slide.file %>-800.jpg" 
                                                class="d-block w-100 h-100" 
                                                alt="<%= slide.alt %>" 
                                                loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                                            >
                                            </picture>

                                          <button 
                                                type="button" 
                                                class="btn btn-outline-secondary position-absolute top-0 end-0 m-3 modal-enlarge-btn" 
                                                data-image-src="/images/responsive/<%= slide.file %>-1600.jpg" 
                                                data-image-alt="<%= slide.alt %>"
                                                aria-label="View large image of <%= slide.alt %>">
                                                <i class="bi bi-arrows-fullscreen"></i> 
                                            </button>

                                        </div>    
                                    </div>
                                <% }) %>
                            </div>
