<!-- information contained in the head element of the HTML document, such as meta tags, links to stylesheets, and the title of the page. It uses EJS templating to dynamically set the title based on a variable passed to the template. -->
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <style>
        /* Inline critical hide */
        .no-js .hero-d2,
        .no-js .hero-d3 {
        display: none;
        }
    </style>
    
    <!-- Bootstrap CSS -->
    <!-- <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
    -->
    <!-- Bootstrap CSS (latest stable 5.3.8) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" 
          rel="stylesheet" 
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" 
          crossorigin="anonymous">
   
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/styles.css">

    <title><%= title %></title>

    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Kalam:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- <title>KKilsby Profile</title> -->

    <script defer data-domain="kriskilsby.com" src="https://analytics.kriskilsby.com/js/script.js"></script>


</head>
</html>