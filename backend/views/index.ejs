<!DOCTYPE html>
<!-- <html lang="en"> -->
<html lang="en" class="no-js">
<head>
    <!-- Add Head component -->
    <%- include ('components/head') %>
    <title>Portfolio Homepage</title>
</head>

<body class="<%= page %>">
<!-- <body> -->
    <header>    
        <!-- Hero Section -->
        <div class="bg-hero-img position-relative vh-100 w-100 overflow-hidden m-0 p-0">

            <!-- Responsive hero image -->
            <picture>
                <source 
                srcset="
                    /images/responsive/cromer-hero-400.webp 400w,
                    /images/responsive/cromer-hero-800.webp 800w,
                    /images/responsive/cromer-hero-1200.webp 1200w,
                    /images/responsive/cromer-hero-1600.webp 1600w,
                    /images/responsive/cromer-hero-2400.webp 2400w
                "
                sizes="100vw"
                type="image/webp">
                <source 
                srcset="
                    /images/responsive/cromer-hero-400.jpg 400w,
                    /images/responsive/cromer-hero-800.jpg 800w,
                    /images/responsive/cromer-hero-1200.jpg 1200w,
                    /images/responsive/cromer-hero-1600.jpg 1600w,
                    /images/responsive/cromer-hero-2400.jpg 2400w
                "
                sizes="100vw"
                type="image/jpeg">
                <img 
                    src="/images/responsive/cromer-hero-1600.jpg" 
                    alt="View of Cromer, Norfolk, UK" 
                    class="w-100 h-100 object-fit-cover d-block"
                    style="display:block;">
            </picture>

            <!-- Overlay content (navbar + text) -->
            <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-between text-white">

                <!-- Navbar -->
                <%- include ('components/navbar') %>

                <!-- Centered hero text -->
                <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 text-center">
                <h1 class="hero-d1">Welcome to my portfolio</h1>
                <h2 class="hero-d2">My journey into</h2>
                <h2 class="hero-d3">Computer Science</h2>
                </div>

                <!-- Photo credit -->
                <div class="p-3 text-start">
                <p class="hero-subtext mb-0">Cromer, Norfolk, UK by day (Photo & Processing by Kris Kilsby)</p>
                </div>
            </div>

        </div>

    </header> 

    <!-- Intro section under hero -->
    <section class="about-intro text-center py-5">
        <div class="container-fluid">
            <h2 class="about-title">Engaging & Personal</h2>
            <p class="about-text">
                I love turning tricky data problems into tools that feel simple, intuitive, and engaging. Want to know more about me? 
                The cards below share my background, job experiences, and my MSc Computing Science journey.
            </p>
        </div>
    </section>

    <!-- Card section with carousels -->
    <section id="project-section" class="container carousel-section my-4 mt-5">
        <div class="row">
            <!-- First card -->
            <div class="col-12 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <!-- <div id="kkprofile" class="carousel carousel-dark slide" data-bs-ride="carousel"> -->
                    <div id="kkprofile" class="carousel slide carousel-dark carousel-fade" data-bs-ride="carousel">

                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#kkprofile" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#kkprofile" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#kkprofile" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>
                        <div class="carousel-inner">
                            <% 
                            const slideskk = [
                            { file: 'kk-photo-1', alt: 'First image of Kris Kilsby' },
                            { file: 'kk-photo-2', alt: 'Second image of Kris Kilsby' },
                            { file: 'kk-photo-3', alt: 'Third image of Kris Kilsby' }
                            ]; 
                            slideskk.forEach((slide, index) => { 
                            %>
                                <div class="carousel-item <%= index === 0 ? 'active' : '' %>" data-bs-interval="4000">
                                    <div class="position-relative">
                                        <picture>
                                        <source 
                                            srcset="
                                            /images/responsive/<%= slide.file %>-400.webp 400w,
                                            /images/responsive/<%= slide.file %>-800.webp 800w,
                                            /images/responsive/<%= slide.file %>-1200.webp 1200w,
                                            /images/responsive/<%= slide.file %>-1600.webp 1600w,
                                            /images/responsive/<%= slide.file %>-2400.webp 2400w
                                            "
                                            sizes="(max-width: 576px) 100vw, 
                                                    (max-width: 768px) 80vw,
                                                    (max-width: 1200px) 45vw, 
                                                    30vw"
                                            type="image/webp"
                                        >
                                        <source 
                                            srcset="
                                            /images/responsive/<%= slide.file %>-400.jpg 400w,
                                            /images/responsive/<%= slide.file %>-800.jpg 800w,
                                            /images/responsive/<%= slide.file %>-1200.jpg 1200w,
                                            /images/responsive/<%= slide.file %>-1600.jpg 1600w,
                                            /images/responsive/<%= slide.file %>-2400.jpg 2400w
                                            "
                                            sizes="(max-width: 576px) 100vw, 
                                                    (max-width: 768px) 80vw,
                                                    (max-width: 1200px) 45vw, 
                                                    30vw"
                                            type="image/jpeg"
                                        >
                                        <img 
                                            src="/images/responsive/<%= slide.file %>-800.jpg" 
                                            class="d-block w-100" 
                                            alt="<%= slide.alt %>" 
                                            loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                                        >
                                        </picture>

                                        <button 
                                            type="button" 
                                            class="btn btn-outline-secondary position-absolute top-0 end-0 m-3 modal-enlarge-btn" 
                                            data-image-src="/images/responsive/<%= slide.file %>-1200.jpg" 
                                            data-image-alt="<%= slide.alt %>"
                                            aria-label="View large image of <%= slide.alt %>">
                                            <i class="bi bi-arrows-fullscreen"></i> 
                                        </button>

                                    </div>    
                                </div>
                            <% }) %>
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#kkprofile" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#kkprofile" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>

                    <div class="card-body text-center position-relative">
                        <a href="/profile" class="stretched-link" aria-label="View full profile page"></a>
                        <h5 class="card-title">Kris Kilsby - My Profile</h5>
                        <p class="card-text">
                            Learn a little about who I am, where I am from, what I enjoy doing, and what experiences I have gained.
                        </p>
                    </div>
                </div>
            </div>
            
            <!-- Second card -->
            <div class="col-12 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div id="kkMSc" class="carousel carousel-dark  carousel-fade" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#kkMSc" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#kkMSc" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#kkMSc" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>
                        <div class="carousel-inner">
                            <% 
                            const slidesMSc = [
                            { file: 'info-vis-1', alt: 'Information Visualisation module final project' },
                            { file: 'stork-1', alt: 'Stork movement data map for dissertation project' },
                            { file: 'database-min-01', alt: 'Database Schema Diagram for Database Manipulation module' }
                            ]; 
                            slidesMSc.forEach((slide, index) => { 
                            %>
                                <div class="carousel-item <%= index === 0 ? 'active' : '' %>" data-bs-interval="4000">
                                    <div class="position-relative">
                                        <picture>
                                            <source 
                                                srcset="
                                                /images/responsive/<%= slide.file %>-400.webp 400w,
                                                /images/responsive/<%= slide.file %>-800.webp 800w,
                                                /images/responsive/<%= slide.file %>-1200.webp 1200w,
                                                /images/responsive/<%= slide.file %>-1600.webp 1600w,
                                                /images/responsive/<%= slide.file %>-2400.webp 2400w
                                                "
                                                sizes="(max-width: 576px) 100vw, 
                                                        (max-width: 768px) 80vw,
                                                        (max-width: 1200px) 45vw, 
                                                        30vw"
                                                type="image/webp"
                                            >
                                            <source 
                                                srcset="
                                                /images/responsive/<%= slide.file %>-400.jpg 400w,
                                                /images/responsive/<%= slide.file %>-800.jpg 800w,
                                                /images/responsive/<%= slide.file %>-1200.jpg 1200w,
                                                /images/responsive/<%= slide.file %>-1600.jpg 1600w,
                                                /images/responsive/<%= slide.file %>-2400.jpg 2400w
                                                "
                                                sizes="(max-width: 576px) 100vw, 
                                                        (max-width: 768px) 80vw,
                                                        (max-width: 1200px) 45vw, 
                                                        30vw"
                                                type="image/jpeg"
                                            >
                                            <img 
                                                src="/images/responsive/<%= slide.file %>-800.jpg" 
                                                class="d-block w-100" 
                                                alt="<%= slide.alt %>" 
                                                loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                                            >
                                        </picture>

                                        <button 
                                            type="button" 
                                            class="btn btn-outline-secondary position-absolute top-0 end-0 m-3 modal-enlarge-btn" 
                                            data-image-src="/images/responsive/<%= slide.file %>-1200.jpg" 
                                            data-image-alt="<%= slide.alt %>"
                                            aria-label="View large image of <%= slide.alt %>">
                                            <i class="bi bi-arrows-fullscreen"></i> 
                                        </button>

                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <button class="carousel-control-prev" type="button" data-bs-target="#kkMSc" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#kkMSc" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </div>
                    <div class="card-body text-center position-relative">
                        <a href="profile#eduCollapseUEA" class="stretched-link" aria-label="View MSc Computing Science in profile"></a>
                        <h5 class="card-title">MSc Computing Science</h5>
                        <p class="card-text">
                            A description about the course I have been studying, the modules I have completed, and the skills I have gained.  
                        </p>
                    </div>                     
                </div>
            </div>
        </div>

        <!-- Second row -->
        <div class="row">
            <!-- Third card -->
            <div class="col-12 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div id="kkStork" class="carousel carousel-dark carousel-fade" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#kkStork" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#kkStork" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#kkStork" data-bs-slide-to="2" aria-label="Slide 3"></button>
                        </div>
                         <div class="carousel-inner">
                            <% 
                            const slidesStork = [
                            { file: 'stork-1', alt: 'Stork App user interface' },
                            { file: 'stork-2', alt: 'Filter and map section of App' },
                            { file: 'stork-3', alt: 'DataTables and Highcharts section' }
                            ]; 
                            slidesStork.forEach((slide, index) => { 
                            %>
                                <div class="carousel-item <%= index === 0 ? 'active' : '' %>" data-bs-interval="4000">
                                    <div class="position-relative">
                                        <picture>
                                        <source 
                                            srcset="
                                            /images/responsive/<%= slide.file %>-400.webp 400w,
                                            /images/responsive/<%= slide.file %>-800.webp 800w,
                                            /images/responsive/<%= slide.file %>-1200.webp 1200w,
                                            /images/responsive/<%= slide.file %>-1600.webp 1600w,
                                            /images/responsive/<%= slide.file %>-2400.webp 2400w
                                            "
                                            sizes="(max-width: 576px) 100vw, 
                                                    (max-width: 768px) 80vw,
                                                    (max-width: 1200px) 45vw, 
                                                    30vw"
                                            type="image/webp"
                                        >
                                        <source 
                                            srcset="
                                            /images/responsive/<%= slide.file %>-400.jpg 400w,
                                            /images/responsive/<%= slide.file %>-800.jpg 800w,
                                            /images/responsive/<%= slide.file %>-1200.jpg 1200w,
                                            /images/responsive/<%= slide.file %>-1600.jpg 1600w,
                                            /images/responsive/<%= slide.file %>-2400.jpg 2400w
                                            "
                                            sizes="(max-width: 576px) 100vw, 
                                                    (max-width: 768px) 80vw,
                                                    (max-width: 1200px) 45vw, 
                                                    30vw"
                                            type="image/jpeg"
                                        >
                                        <img 
                                            src="/images/responsive/<%= slide.file %>-800.jpg" 
                                            class="d-block w-100" 
                                            alt="<%= slide.alt %>" 
                                            loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                                        >
                                        </picture>

                                       <button 
                                            type="button" 
                                            class="btn btn-outline-secondary position-absolute top-0 end-0 m-3 modal-enlarge-btn" 
                                            data-image-src="/images/responsive/<%= slide.file %>-1200.jpg" 
                                            data-image-alt="<%= slide.alt %>"
                                            aria-label="View large image of <%= slide.alt %>">
                                            <i class="bi bi-arrows-fullscreen"></i> 
                                        </button>

                                    </div>    
                                </div>
                            <% }) %>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#kkStork" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#kkStork" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </div>

                    <div class="card-body text-center position-relative">
                        <a href="/stork-app" target="_blank" rel="noopener noreferrer" class="stretched-link" aria-label="View the Stork App"></a>
                        <h5 class="card-title">Stork Migration Explorer</h5>
                        <p class="card-text">
                            My MSc Computing Science dissertation project — an interactive tool for exploring stork movement data.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Fourth card -->
            <div class="col-12 col-md-6 mb-4">
                <div class="card border-0 shadow-sm">
                    <div id="kkHotel" class="carousel carousel-dark carousel-fade" data-bs-ride="carousel">
                        <div class="carousel-indicators">
                            <button type="button" data-bs-target="#kkHotel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                            <button type="button" data-bs-target="#kkHotel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                            <button type="button" data-bs-target="#kkHotel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                            <button type="button" data-bs-target="#kkHotel" data-bs-slide-to="3" aria-label="Slide 4"></button>
                            <button type="button" data-bs-target="#kkHotel" data-bs-slide-to="4" aria-label="Slide 5"></button>
                        </div>
                         <div class="carousel-inner">
                            <% 
                            const slidesHotel = [
                            { file: 'hotel-1', alt: 'Hero section of the fictional Crown Hotel website' },
                            { file: 'hotel-2', alt: 'Room details and booking page for the fictional Crown Hotel' },
                            { file: 'hotel-3', alt: 'Contact page of the fictional Crown Hotel website' },
                            { file: 'hotel-4', alt: 'Facilities and amenities section of the fictional Crown Hotel' },
                            { file: 'hotel-5', alt: 'Local area information section of the fictional Crown Hotel' }
                            ]; 
                            slidesHotel.forEach((slide, index) => { 
                            %>
                                <div class="carousel-item <%= index === 0 ? 'active' : '' %>" data-bs-interval="4000">
                                    <div class="position-relative">
                                        <picture>
                                        <source 
                                            srcset="
                                            /images/responsive/<%= slide.file %>-400.webp 400w,
                                            /images/responsive/<%= slide.file %>-800.webp 800w,
                                            /images/responsive/<%= slide.file %>-1200.webp 1200w,
                                            /images/responsive/<%= slide.file %>-1600.webp 1600w,
                                            /images/responsive/<%= slide.file %>-2400.webp 2400w
                                            "
                                            sizes="(max-width: 576px) 100vw, 
                                                    (max-width: 768px) 80vw,
                                                    (max-width: 1200px) 45vw, 
                                                    30vw"
                                            type="image/webp"
                                        >
                                        <source 
                                            srcset="
                                            /images/responsive/<%= slide.file %>-400.jpg 400w,
                                            /images/responsive/<%= slide.file %>-800.jpg 800w,
                                            /images/responsive/<%= slide.file %>-1200.jpg 1200w,
                                            /images/responsive/<%= slide.file %>-1600.jpg 1600w,
                                            /images/responsive/<%= slide.file %>-2400.jpg 2400w
                                            "
                                            sizes="(max-width: 576px) 100vw, 
                                                    (max-width: 768px) 80vw,
                                                    (max-width: 1200px) 45vw, 
                                                    30vw"
                                            type="image/jpeg"
                                        >
                                        <img 
                                            src="/images/responsive/<%= slide.file %>-800.jpg" 
                                            class="d-block w-100" 
                                            alt="<%= slide.alt %>" 
                                            loading="<%= index === 0 ? 'eager' : 'lazy' %>"
                                        >
                                        </picture>

                                       <button 
                                            type="button" 
                                            class="btn btn-outline-secondary position-absolute top-0 end-0 m-3 modal-enlarge-btn" 
                                            data-image-src="/images/responsive/<%= slide.file %>-1200.jpg" 
                                            data-image-alt="<%= slide.alt %>"
                                            aria-label="View large image of <%= slide.alt %>">
                                            <i class="bi bi-arrows-fullscreen"></i> 
                                        </button>

                                    </div>    
                                </div>
                            <% }) %>
                        </div>
                        <button class="carousel-control-prev" type="button" data-bs-target="#kkHotel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#kkHotel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    </div>
                    <div class="card-body text-center">
                        <a href="/launch-hotel" class="stretched-link" aria-label="View MSc Computing Science in profile"></a>
                        <h5 class="card-title">Group Project - The Crown Hotel</h5>
                        <p class="card-text">
                            A group project for Website Development, where we built a fictional hotel booking and staff management web application.
                        </p>
                    </div>
                </div>
            </div>
        </div>

    </section>

    <!-- Modal -->
    <div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="imageModalLabel">Image Title</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <img src="" id="modalImage" class="img-fluid w-100" alt="Enlarged view">
                </div>
                <div class="modal-footer justify-content-center">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

  


    <!-- footer -->
    <%- include ('components/footer') %>



</body>
</html>
