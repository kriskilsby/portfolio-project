                            const slideskk = [
                            { file: 'kk-photo-1', alt: 'First image of Kris Kilsby' },
                            { file: 'kk-photo-2', alt: 'Second image of Kris Kilsby' },
                            { file: 'kk-photo-3', alt: 'Third image of Kris Kilsby' }
