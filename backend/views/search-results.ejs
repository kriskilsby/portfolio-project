<!DOCTYPE html>
<html lang="en" class="no-js">

<head>
  <!-- Shared head (includes meta, CSS, fonts, etc.) -->
  <%- include('components/head') %>
  <title>Search Results Page</title>
</head>

<body class="<%= page %>">

  <!-- Navbar (same as on your other pages) -->
  <%- include('components/navbar') %>

  <!-- Main Content -->
  <div class="search-results-container mt-5 mb-5 pt-5">
    <h2 class="mt-5 mb-5 text-center">Search results for "<%= query %>"</h2>

    <% if (results.length === 0) { %>
      <p class="text-center text-muted">No results found.</p>
    <% } else { %>
      <ul class="list-group shadow-sm">
        <% results.forEach(item => { %>

          <li class="list-group-item d-flex align-items-center justify-content-start m-3">
            <a href="<%= item.url %>?q=<%= encodeURIComponent(query) %>">
              <strong><%= item.title %></strong>
            </a>
            <br>
            <small><%= item.description %></small>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>

  <!-- Footer -->
  <%- include('components/footer') %>

</body>
</html>