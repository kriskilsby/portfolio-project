    <script>
    // Demo login animation and automatic login
    function demoLogin() {
      const overlay = document.getElementById("demoLoginOverlay");
      overlay.classList.remove("d-none");

      const btn = event.currentTarget;
      let username = "demo_user";

      if (btn.dataset.target.includes("reception")) username = "receptionist";
      else if (btn.dataset.target.includes("housekeeping")) username = "housekeeper";
      else if (btn.dataset.target.includes("management")) username = "manager";

      const password = "Demo123!";
      const userField = document.getElementById("demoUserType");
      const passField = document.getElementById("demoPassType");

      let i = 0;

      // Type username
      const typeUser = setInterval(() => {
        userField.textContent = username.slice(0, i);
        i++;
        if (i > username.length) {
          clearInterval(typeUser);
          let j = 0;

          // Type password bullets
          const typePass = setInterval(() => {
            passField.textContent = "•".repeat(j);
            j++;
            if (j > password.length) {
              clearInterval(typePass);

              // After typing animation, POST to /login
              setTimeout(async () => {
                try {
                  const response = await fetch('/crown-hotel/login', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username, password })
                  });

                  if (response.redirected) {
                    // Navigate to the URL your server redirected to
                    window.location.href = response.url;
                  } else {
                    console.error('❌ Demo login failed');
                    overlay.classList.add("d-none");
                  }
                } catch (err) {
                  console.error('❌ Error during demo login fetch', err);
                  overlay.classList.add("d-none");
                }
              }, 600);
            }
          }, 100); // Adjust typing speed here
        }
      }, 100); // Adjust typing speed here
    }

    // Attach click listeners to demo buttons
    document.querySelectorAll(".launch-hotel-btn").forEach(btn => {
      btn.addEventListener("click", demoLogin);
    });
  </script>



