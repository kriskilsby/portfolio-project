<nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
  <div class="container-fluid">
    <a class="navbar-brand" href="#">Dashboard</a>

    <!-- Always visible logout button -->
    <a class="btn btn-danger ms-auto d-lg-none" href="/launch-hotel">Logout</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#staffNavbar" aria-controls="staffNavbar" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="staffNavbar">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if (staffUser.role === 'receptionist') { %>
          <li class="nav-item"><a class="nav-link" href="/crown-hotel/staff/reception">Reception Dashboard</a></li>
        <% } %>
        <% if (staffUser.role === 'housekeeper') { %>
          <li class="nav-item"><a class="nav-link" href="/crown-hotel/staff/housekeeping">Housekeeping</a></li>
        <% } %>
        <% if (staffUser.role === 'manager') { %>
          <li class="nav-item"><a class="nav-link" href="/crown-hotel/staff/management">Management Dashboard</a></li>
        <% } %>
      </ul>

      <!-- Logout button inside collapse for large screens -->
      <ul class="navbar-nav ms-auto d-none d-lg-flex">
        <li class="nav-item">
          <a class="btn btn-danger" href="/launch-hotel">Logout</a>
        </li>
      </ul>
    </div>
  </div>
</nav>