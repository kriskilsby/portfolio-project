<%- include('header', { title: 'Messages'}) %>
<%- include('../partials/navbar-staff') %>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Contact Messages</title>
  <link href="/crown-hotel/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <div class="container mt-5">
    <h1 class="mb-4">📬 Contact Messages</h1>

    <% if (messages.length > 0) { %>
    <div class="table-responsive">
      <table class="table table-striped table-bordered">
        <thead class="table-dark">
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Subject</th>
            <th>Message</th>
            <th>Received</th>
          </tr>
        </thead>
        <tbody>
          <% messages.forEach(msg => { %>
            <tr>
              <td><%= msg.name %></td>
              <td><%= msg.email %></td>
              <td><%= msg.subject %></td>
              <td><%= msg.message %></td>
              <td><%= msg.submitted %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } else { %>
      <p>No messages yet.</p>
    <% } %>

    <a href="/crown-hotel/staff/management" class="btn btn-secondary mt-4">← Back to Dashboard</a>
  </div>
</body>
</html>

<%- include('../partials/footer-staff') %>